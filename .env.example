# --- Frontend ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SITE_URL=
# Must point to the same origin as MINIO_PUBLIC_URL below: the backend builds
# media (logo/video) URLs from MINIO_PUBLIC_URL, and the frontend CSP only
# allows this origin to load them.
NEXT_PUBLIC_MEDIA_URL=https://minio.lyratech.com.mx
# Backend URL reachable from inside the frontend container's own network — used
# only by server components. NEXT_PUBLIC_API_URL may point at a public domain
# or localhost, neither of which necessarily resolves inside that container.
# docker-compose sets this to http://backend:8000; leave blank locally
# (falls back to NEXT_PUBLIC_API_URL / localhost:8000).
API_INTERNAL_URL=

# --- Backend ---
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
TURNSTILE_SECRET_KEY=

# Session cookie holding the access token (shared by backend + frontend middleware).
# Prod:  AUTH_COOKIE_NAME=lyratech_session       AUTH_COOKIE_DOMAIN=.lyratech.com.mx
# Dev:   AUTH_COOKIE_NAME=lyratech_session_dev   AUTH_COOKIE_DOMAIN=.lyratech.com.mx
# Local: leave both empty (host-only, non-Secure cookie over http://localhost).
AUTH_COOKIE_NAME=
AUTH_COOKIE_DOMAIN=

BACKEND_CORS_ORIGINS=

# Object storage (MinIO) — portfolio logos/videos.
# STORAGE_ENV_PREFIX: local | dev | prod (top-level folder inside the bucket).
# MINIO_ENDPOINT is host[:port] only, no scheme.
MINIO_ENDPOINT=minio.lyratech.com.mx
MINIO_SECURE=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lyratech
# Must match NEXT_PUBLIC_MEDIA_URL above (same origin) — see the comment there.
MINIO_PUBLIC_URL=https://minio.lyratech.com.mx
# Blank means "local" (outside Docker, e.g. running the backend directly for
# dev/tests). On servers leave it empty too so docker-compose's own default
# applies (prod/dev per compose file) instead of this file's value.
STORAGE_ENV_PREFIX=

RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_FROM_NAME=
FRONTEND_URL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_TIMEOUT_SECONDS=

# --- Database ---
DATABASE_PORT=
MYSQL_ROOT_PASSWORD=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# --- Backup ---
BACKUP_MAX_BACKUPS=4
BACKUP_CRON_TIME=0 3 * * *
BACKUP_GZIP_LEVEL=6
